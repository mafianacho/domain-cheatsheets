{
  "name": "domain-cheatsheets-mcp",
  "version": "0.1.0",
  "description": "MCP server that serves the domain-cheatsheets dictionary to AI agents (stdio + Streamable HTTP).",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "domain-cheatsheets-mcp": "dist/src/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "check": "npm run build && node dist/scripts/check.js",
    "generate": "npm run build && node dist/scripts/generate.js",
    "start": "node dist/src/stdio.js",
    "start:http": "node dist/src/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
